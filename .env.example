HOST=0.0.0.0
PORT=8120
BACKEND_PORT=8120
FRONTEND_PORT=5178
IMAGE_TAG=latest

# 默认使用 SQLite 单文件数据库，随 data 目录一起持久化，不需要额外数据库服务。
# 连接建立时会自动开启 WAL、busy_timeout 等参数，无需手工调优。
DATABASE_URL=sqlite+aiosqlite:///./data/plugin_registry.db
# 如需改用 MySQL，换成下面这行，并用 docker compose --profile mysql 启动数据库：
# DATABASE_URL=mysql+aiomysql://pluginhub:CHANGE_ME@host.docker.internal:3306/pluginhub?charset=utf8mb4
DATABASE_CONNECT_TIMEOUT=10

# Linux 裸机部署时填前端构建产物目录，后端顺带托管前端（单端口运行）；
# Docker 部署由 Nginx 容器负责，保持留空即可。
FRONTEND_DIST=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 应用加密密钥：用于加密保存 SMTP 密码、GitHub 令牌，并参与邮箱验证码哈希。
# 请替换为随机长字符串；服务运行后不要随意修改，否则历史加密配置无法解密。
SETTINGS_ENCRYPTION_SECRET=CHANGE_ME_SETTINGS_ENCRYPTION_SECRET

# 插件库对外地址：填写后索引里的插件包下载地址会输出绝对地址，
# 供下游插件市场直接下载；留空则输出 /api/registry/packages/... 相对路径。
PUBLIC_SERVICE_URL=

# 分发接口接入令牌：索引、插件列表与插件包下载都需要鉴权。
# 下游请求带上 Authorization: Bearer <令牌> 或 X-Registry-Token。
# 也可以登录后台「系统设置 → 接入令牌」生成保存；留空表示只允许登录账号访问。
REGISTRY_TOKEN=

# 插件系统
PLUGIN_ENABLED=true
PLUGIN_DATA_DIR=./data/plugins
PLUGIN_PACKAGE_MAX_SIZE=10485760
PLUGIN_REPO_TIMEOUT=60
# 可选：GitHub 令牌，用于自动探测仓库最新版本，提高接口调用频率上限
# （也可以登录后台「系统设置 → GitHub 接口」填写，后台可加密保存）
PLUGIN_REPO_TOKEN=

CORS_ORIGINS=*
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FILE=./data/logs/plugin_registry.log
LOG_BACKUP_COUNT=30
