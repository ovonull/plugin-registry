HOST=0.0.0.0
PORT=8120
BACKEND_PORT=8120
FRONTEND_PORT=5178
IMAGE_TAG=latest

# Docker 容器访问外部 MySQL；用户名、密码、数据库名请替换为实际值。
DATABASE_URL=mysql+aiomysql://napcat:CHANGE_ME@host.docker.internal:3306/napcat?charset=utf8mb4
DATABASE_CONNECT_TIMEOUT=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# 应用加密密钥：用于加密保存 SMTP 密码、AI 平台 API Key，并参与邮箱验证码哈希。
# 请替换为随机长字符串；服务运行后不要随意修改，否则历史加密配置无法解密。
SETTINGS_ENCRYPTION_SECRET=CHANGE_ME_SETTINGS_ENCRYPTION_SECRET
NAPCAT_TOKEN=
SERVICE_TOKEN=
PUBLIC_SERVICE_URL=
REDIS_URL=redis://:CHANGE_ME@host.docker.internal:6379/0
AI_FOLLOWUP_TTL=259200
PLUGIN_ENABLED=true
PLUGIN_DATA_DIR=./data/plugins
PLUGIN_PACKAGE_MAX_SIZE=10485760
PLUGIN_REPO_TIMEOUT=60
# 可选：GitHub 令牌，只用于自动探测最新版本，提高接口调用频率上限
PLUGIN_REPO_TOKEN=
PLUGIN_RUNTIME=subprocess
PLUGIN_EVENT_TIMEOUT=10
PLUGIN_HTTP_TIMEOUT=10
CORS_ORIGINS=*
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FILE=./data/logs/napcat_service.log
LOG_BACKUP_COUNT=30
